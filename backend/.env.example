# ============================================================
# .env — Aware Guard Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
#
# Usage:
#   Windows: set DB_HOST=localhost && node server.js
#   Or use: npx dotenv-cli -e .env -- node server.js
#   Or install dotenv and require it at top of server.js
# ============================================================

# ─── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=awareguard

# ─── Authentication ───────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
